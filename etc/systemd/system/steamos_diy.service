[Unit]
Description=SteamMachine-DIY - Session Launcher
After=systemd-user-sessions.service dbus.service systemd-logind.service

# session_launch.py exits 75 on every session switch (a wanted restart),
# and a session that dies right at start falls back to Desktop. The
# runaway case is Desktop itself dying at start (e.g. broken Plasma):
# this limit lets systemd give up instead of restarting every second,
# with room to spare for normal switching. Recover from another TTY or
# SSH (getty on TTY1 is masked).
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=notify
User={{USER}}
PAMName=login
Environment=XDG_RUNTIME_DIR=/run/user/{{UID}}
Environment=SSOT_CONF=/etc/default/steamos_diy.conf
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_DESKTOP_PORTAL_DIR=/usr/share/xdg-desktop-portal/portals

ExecStart=/usr/bin/python3 /usr/local/lib/steamos_diy/session_launch.py

# Resilience & TTY Management
Restart=on-failure
RestartSec=1.0s
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVTDisallocate=yes
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=graphical.target
